# ---------------------------------------------------------------------------
# Zoho Webinar OAuth 2.0 — server-side only. Never commit a copy of this
# file with real values. See README.md → "Zoho Webinar Integration" for the
# full one-time setup walkthrough.
# ---------------------------------------------------------------------------

# From the Zoho API Console (Self Client). Never expose these to the browser.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Obtained ONCE via the /api/auth/zoho/start -> /api/auth/zoho/callback
# bootstrap flow (see README). Zoho refresh tokens don't expire unless
# revoked, so this is a long-lived, set-it-once value.
ZOHO_REFRESH_TOKEN=

# Data-center-specific base URLs. This deployment is on the India (.in)
# data center — swap the TLD if your Zoho account is on a different one
# (.com, .eu, .com.au, .jp, .com.cn — check by logging into webinar.zoho.<tld>).
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_WEBINAR_API_URL=https://webinar.zoho.in/api/v2

# Shared Zoho organization id (zsoid), used for every event unless a
# specific entry in netlify/functions/_lib/eventsConfig.json overrides it.
# The OAuth bootstrap callback page attempts to discover this automatically;
# see README for the manual fallback if it can't.
ZOHO_ZSOID=

# Sent as the required X-ZSOURCE header on every Zoho Webinar API call.
ZOHO_X_ZSOURCE=RevApexAI

# One-time shared secret that guards /api/auth/zoho/start and
# /api/auth/zoho/callback so they aren't a permanently open, unauthenticated
# "start OAuth" endpoint. Set it only while bootstrapping the refresh token,
# then remove/rotate it in Netlify's env vars once done.
ZOHO_SETUP_SECRET=

# Used to build the exact OAuth redirect_uri sent to Zoho — must match what's
# registered in the Zoho API Console for this client, character for character:
# https://events.revapex.ai/api/auth/zoho/callback
PUBLIC_BASE_URL=https://events.revapex.ai

# CORS allow-list for /api/webinar/register (comma-separated origins).
ALLOWED_ORIGINS=https://events.revapex.ai
